{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.SemanticKernel": "Verbose",
        "Ukinee.AspNetCore.LongTaskWorkers": "Debug",
        "Ukinee.AspNetCore.LongTaskWorkers.InfrastructureServices": "Information",
        "Workers.Common.Infrastructure": "Debug",
        "Semantic.Infrastructure.HttpHandlers": "Debug",
        "Microsoft.Extensions.Http": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/backednd_errors-.txt",
          "rollingInterval": "Day",
          "restrictedToMinimumLevel": "Warning",
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "AllowedHosts": "*"
}
